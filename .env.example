# ==============================================================================
# Smart Restaurant Management System - Environment Variables Example
# Lưu ý: Không lưu mật khẩu thật hoặc secret vào source code / git.
# ==============================================================================

# Cổng chạy ứng dụng
PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/smart_restaurant?schema=public"

# Cho phép fallback sang PGlite embedded trong dev/test khi PostgreSQL local chưa khởi động
# LƯU Ý: Biến này BỊ VÔ HIỆU HÓA HOÀN TOÀN TRONG PRODUCTION (NODE_ENV=production luôn fail fast)
DB_FALLBACK_PGLITE=true

# Chuỗi bí mật ký xác thực JWT (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET="smart_restaurant_jwt_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="8h"

# Cấu hình Amazon S3 (Private Bucket lưu trữ ảnh món ăn)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="smart-restaurant-media-private"
S3_BLOCK_PUBLIC_ACCESS="true"

# Cấu hình Amazon CloudWatch Logging
CLOUDWATCH_LOG_GROUP="/aws/ec2/smart-restaurant-app"
CLOUDWATCH_LOG_STREAM="backend-production"
ENABLE_CLOUDWATCH_LOGS="false"

# Cấu hình ngưỡng cảnh báo quy tắc thông minh (có thể điều chỉnh)
LOW_STOCK_THRESHOLD=5
KITCHEN_WARNING_DELAY_MINUTES=10

# Cấu hình thanh toán chuyển khoản QR (Mô phỏng VietQR thủ công)
# Lưu ý: Đây là QR chuyển khoản mô phỏng/thủ công, không tích hợp cổng thanh toán, webhook ngân hàng hoặc tự động xác nhận giao dịch.
# Không hard-code thông tin tài khoản thật vào source code.
# Nếu thiếu hoặc tắt (PAYMENT_QR_ENABLED=false), giao diện sẽ hiển thị thông báo "Chưa cấu hình thông tin QR chuyển khoản." an toàn.
PAYMENT_BANK_BIN=970436
PAYMENT_BANK_NAME=Vietcombank
PAYMENT_ACCOUNT_NUMBER=1234567890
PAYMENT_ACCOUNT_NAME=NHA HANG SMART RESTAURANT
PAYMENT_QR_ENABLED=true


